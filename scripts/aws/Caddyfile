dealoop.miracleraven.com {
 @compressible not path /api/v1/events/stream
 encode @compressible zstd gzip
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy strict-origin-when-cross-origin
  X-Frame-Options DENY
  Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Content-Security-Policy "frame-ancestors 'none'"
  Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
 }
 request_body {
  max_size 12MB
 }
 reverse_proxy 127.0.0.1:3000 {
  header_up -OAI-Authenticated-User-Id
  header_up -OAI-Authenticated-User-Email
  header_up -OAI-Authenticated-User-Full-Name
  header_up -OAI-Sites-Authorization
  header_up CF-Connecting-IP {remote_host}
 }
}
